# OpenRouter — LLM API. Use a DEDICATED key for Heroku with a €10 hard cap
# set at the key level. Disable auto-topup at the account level.
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase Postgres connection string.
# IMPORTANT: use the POOLER endpoint, not the direct db.*.supabase.co one.
# Supabase's direct endpoint is IPv6-only on the free tier since 2024;
# Heroku dynos have no IPv6, so asyncpg fails with "Network is unreachable".
# The pooler is IPv4 and works everywhere. Get the exact string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# -> "Transaction pooler". Note the username is postgres.<project_ref>
# (NOT just "postgres"), and the region/port are baked in.
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Admin password for the beta. The frontend login screen posts this to
# /api/login; a signed cookie is issued and checked by middleware.
ADMIN_PASSWORD=change-me

# Random hex used to sign session cookies. Generate once per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-64-random-hex-chars

# Kill switch. Set to 1 to make all /api/* except /api/health return 503.
# Flip this in the Heroku dashboard if something goes wrong — no redeploy needed.
DISABLED=
